{
    "name": "ioms/backend",
    "description": "Inventory & Order Management System - PHP native backend",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^1",
        "phpunit/phpcov": "^9",
        "phpunit/phpunit": "^10",
        "squizlabs/php_codesniffer": "^3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "coverage": "bash scripts/coverage.sh",
        "sonar": [
            "@putenv COMPOSER_PROCESS_TIMEOUT=0",
            "[ -n \"$SONAR_TOKEN\" ] || { echo 'SONAR_TOKEN belum di-export (buat di SonarQube: My Account > Security).'; exit 1; }",
            "@coverage",
            "docker compose -f docker-compose.sonar.yml run --rm scanner sonar-scanner -Dsonar.qualitygate.wait=true"
        ],
        "stan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
