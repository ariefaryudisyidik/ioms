<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve existing files and directories (assets, uploads, etc.) as-is.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes through the front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Disallow directory listings.
Options -Indexes

# Uploads are made inert by public/uploads/.htaccess and by the Apache config in the Dockerfile.

# Never serve hidden files (.htaccess, .env copies, ...).
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
